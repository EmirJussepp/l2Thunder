// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING_PAYMENT // orden creada, esperando confirmación de Mercado Pago
  PAID // pago confirmado, esperando que el bridge la levante
  PROCESSING // el bridge la levantó en /api/bridge/pending, procesándola (con lease/timeout)
  DELIVERED // el bridge confirmó el envío del correo in-game
  FAILED
  CANCELED
}

enum PackageKind {
  COIN_PACK // se compra con pesos reales, otorga Coins of Luck
  BOX // caja de skin de una rareza fija (Normal/Épica/Legendaria), se paga en coins
  VIP // pase temporal con boost de progreso, se paga en coins
}

model DonationPackage {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  kind          PackageKind @default(COIN_PACK)
  priceArsCents Int? // sólo COIN_PACK: precio real en pesos
  coinsGranted  Int? // sólo COIN_PACK: coins que otorga
  priceCoins    Int? // sólo VIP/BOX: costo en Coins of Luck
  durationDays  Int? // sólo VIP
  perks         String[]
  highlight     Boolean     @default(false)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  orders DonationOrder[]
}

// Sin verificación por código: el nombre lo tipea el jugador en el checkout y se
// acredita tal cual. Es el nombre del PERSONAJE, no de la cuenta — la entrega en el
// juego (custom_mail) es por objectId de personaje, y una cuenta puede tener varios.
model DonationOrder {
  id             String          @id @default(cuid())
  packageId      String
  package        DonationPackage @relation(fields: [packageId], references: [id])
  characterName  String
  status         OrderStatus     @default(PENDING_PAYMENT)
  mpPreferenceId String?
  mpPaymentId    String?         @unique
  amountArsCents Int // monto real cobrado por Mercado Pago
  coinsCredited  Int // Coins of Luck que se acreditan al personaje
  bridgeError    String? // motivo si falló la acreditación en el gameserver
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  paidAt         DateTime?
  deliveredAt    DateTime?

  @@index([characterName])
  @@index([status])
}
