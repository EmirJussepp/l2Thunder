// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING_PAYMENT // orden creada, esperando confirmación de Mercado Pago
  PAID // pago confirmado, todavía no acreditado en el gameserver
  DELIVERED // el script puente confirmó la acreditación de coins en la cuenta
  FAILED
  CANCELED
}

enum PackageKind {
  COIN_PACK // se compra con pesos reales, otorga Coins of Luck
  BOX // caja de skin de una rareza fija (Normal/Épica/Legendaria), se paga en coins
  VIP // pase temporal con boost de progreso, se paga en coins
}

model DonationPackage {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  kind          PackageKind @default(COIN_PACK)
  priceArsCents Int? // sólo COIN_PACK: precio real en pesos
  coinsGranted  Int? // sólo COIN_PACK: coins que otorga
  priceCoins    Int? // sólo VIP/BOX: costo en Coins of Luck
  durationDays  Int? // sólo VIP
  perks         String[]
  highlight     Boolean     @default(false)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  orders DonationOrder[]
}

// Sin verificación de cuenta por código: el account_name lo tipea el jugador
// en el checkout y se acredita tal cual. El error a corregir manualmente si
// se equivoca es más barato que forzar un comando nuevo en el gameserver.
model DonationOrder {
  id              String          @id @default(cuid())
  packageId       String
  package         DonationPackage @relation(fields: [packageId], references: [id])
  gameAccountName String
  status          OrderStatus     @default(PENDING_PAYMENT)
  mpPreferenceId  String?
  mpPaymentId     String?         @unique
  amountArsCents  Int // monto real cobrado por Mercado Pago
  coinsCredited   Int // Coins of Luck que se acreditan a la cuenta
  bridgeError     String? // motivo si falló la acreditación en el gameserver
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  paidAt          DateTime?
  deliveredAt     DateTime?

  @@index([gameAccountName])
  @@index([status])
}
